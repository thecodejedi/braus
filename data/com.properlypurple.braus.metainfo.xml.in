<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.properlypurple.braus</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Braus</name>
  <summary>Select a browser every time you click a link</summary>
  <description>
    <p>Braus is a small application to select a browser every time you click a link anywhere.</p>
    <p>This is especially useful if you have multiple browsers or profiles, and you want to be able to open certain links in certain browsers. Very useful for web developers, but also for a lot of other people.</p>
    <p>Braus is a GNU/Linux alternative to apps such as Choosy, Browserchooser and Browserosaurus.</p>
  </description>
  <launchable type="desktop-id">com.properlypurple.braus.desktop</launchable>
  <icon type="stock" height="128" width="128">com.properlypurple.braus</icon>
  <screenshots>
    <screenshot type="default">
      <caption>The browser picker with the URL bar, hotkey hints, profile button and private-window toggle</caption>
      <image type="source" width="560" height="340">https://raw.githubusercontent.com/thecodejedi/braus/main/data/screenshots/braus-picker.png</image>
    </screenshot>
    <screenshot>
      <caption>Profile picker popover opened from a browser card</caption>
      <image type="source" width="560" height="460">https://raw.githubusercontent.com/thecodejedi/braus/main/data/screenshots/braus-picker-profiles.png</image>
    </screenshot>
    <screenshot>
      <caption>The URL rules manager listing rules with browser, scope, profile and private options</caption>
      <image type="source" width="560" height="460">https://raw.githubusercontent.com/thecodejedi/braus/main/data/screenshots/braus-rules.png</image>
    </screenshot>
    <screenshot>
      <caption>The add-rule dialog with url/path/domain scope, browser, profile and private window options</caption>
      <image type="source" width="560" height="460">https://raw.githubusercontent.com/thecodejedi/braus/main/data/screenshots/braus-rule-editor.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://braus.properlypurple.com</url>
  <url type="bugtracker">https://github.com/thecodejedi/braus/issues</url>
  <url type="vcs-browser">https://github.com/thecodejedi/braus</url>
  <categories>
    <category>Network</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <releases>
    <release version="0.3.2" date="2026-09-25">
      <description translatable="no">
        <ul>
          <li>Fix broken picker window that prevented the app from starting</li>
          <li>CLI: --set gains --scope url|path|domain, --profile NAME and --private options to match the picker dialog</li>
          <li>URL Rules manager: pick the url/path/domain scope when adding or editing a rule, with a live match preview</li>
          <li>Rules match the most specific (longest) prefix consistently everywhere</li>
          <li>Fix saving of the profile selection in the rules manager</li>
        </ul>
      </description>
    </release>
    <release version="0.3.1" date="2026-09-25">
      <description translatable="no">
        <ul>
          <li>Graphical manager for URL rules: view, add, edit and delete rules, including profile and private-window options</li>
        </ul>
      </description>
    </release>

    <release version="0.3.0" date="2025-09-24">
      <description translatable="no">
        <ul>
          <li>Port to GTK4 and libadwaita</li>
          <li>Update Flatpak runtime to GNOME 48</li>
          <li>Fix crash when pressing non-numeric keys</li>
          <li>Responsive browser grid, Escape to dismiss, app icon</li>
          <li>URL mappings now overwrite instead of duplicating (--set), new --get-mappings command (idea: Pavel “GRbit” Griaznov)</li>
          <li>Collapse duplicate browser entries in the picker (idea: Triet Pham)</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2020-05-01">
      <description translatable="no">
        <p>Initial stable release.</p>
      </description>
    </release>
  </releases>
  <developer id="com.properlypurple">
    <name>Kavya Gokul</name>
  </developer>
  <update_contact>git@properlypurple.com</update_contact>
</component>
