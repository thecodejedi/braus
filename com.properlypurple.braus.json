{
    "app-id" : "com.properlypurple.braus",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "48",
    "sdk" : "org.gnome.Sdk",
    "command" : "braus",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-data/applications:ro",
        "--filesystem=home:ro",
        "--filesystem=/var/run/host/usr:ro",
        "--filesystem=/usr/share/applications:ro"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/share/installed-tests",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "braus",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/thecodejedi/braus.git",
                    "branch" : "main"
                }
            ]
        }
    ]
}
